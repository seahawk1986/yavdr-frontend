#!/bin/bash

set -e

case "$1" in
    configure)
    chmod +x /etc/vdr/shutdown-hooks/S99.yavdr-frontend
    chmod +x /etc/yavdr-frontend/shutdown
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0